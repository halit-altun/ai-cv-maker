PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/cv-ai-maker

JWT_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=90d

# Primary frontend URL (password-reset links). Comma-separate extra CORS origins.
# Netlify + local are always allowed in CORS even if omitted here.
# Recommended on Northflank / production:
FRONTEND_URL=https://cv-ai-maker.netlify.app,http://localhost:3010
# Public backend URL (mail-open pixel + absolute links). Northflank'de ZORUNLU
# (Dockerfile production default da aynı URL'yi set eder).
API_BASE_URL=https://portal--cv-ai-maker--6gvfdf2h8v7d.code.run
TRACKING_PUBLIC_BASE_URL=https://portal--cv-ai-maker--6gvfdf2h8v7d.code.run
# Toplu başvuru optimize PDF render (Next). Boşsa FRONTEND_URL ilk origin kullanılır.
# CV_PDF_RENDER_URL=https://cv-ai-maker.netlify.app
# Backend → Next render-pdf için paylaşılan gizli anahtar (Frontend ile aynı olmalı)
INTERNAL_PIPELINE_SECRET=change-me-pipeline-secret
# Production'da HTTPS zorunludur; auth cookie'leri Secure + SameSite=None olur.
PASSWORD_RESET_PATH=/reset-password
PASSWORD_RESET_EXPIRES_MINUTES=30
EMAIL_VERIFY_EXPIRES_MINUTES=15
LOGIN_MAX_ATTEMPTS=10
LOGIN_FINAL_LOCK_MINUTES=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=CV AI Maker

# Gemini (server-side only — Frontend NEXT_PUBLIC_* kullanmayın)
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
GEMINI_API_KEY_TERTIARY=
# Model adı (boşsa gemini-2.5-flash). Company-based istemci de gemini-2.5-flash gönderir.
# 404 alınırsa yedek modellere otomatik geçilir.
# GEMINI_MODEL=gemini-2.5-flash
# Tam URL ile override (tanımlıysa GEMINI_MODEL ve yedek modeller yok sayılır)
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent

# Outreach korumaları
OUTREACH_MAX_RECIPIENTS_PER_SEND=5
OUTREACH_DAILY_EMAIL_LIMIT=3000
OUTREACH_BLOCK_DOMAIN_RESEND=true
# İki alıcı arası rastgele bekleme (ms) — birden fazla mailde 0.1–5 sn arası random
OUTREACH_SEND_DELAY_MIN_MS=100
OUTREACH_SEND_DELAY_MAX_MS=5000
# (eski) OUTREACH_SEND_DELAY_MS — artık kullanılmıyor; min/max tercih edin

# E-posta doğrulama (gönderimden hemen önce)
EMAIL_VERIFY_ENABLED=true
# Reacher self-hosted — `npm run dev` otomatik başlatır (Docker Desktop gerekir)
REACHER_URL=http://127.0.0.1:8080
REACHER_TIMEOUT_MS=25000
# Docker/Northflank içinde false tutun (container içinde docker run yok)
REACHER_AUTO_START=true
REACHER_CONTAINER_NAME=cv-ai-reacher
REACHER_HOST_PORT=8080
# REACHER_DOCKER_IMAGE=reacherhq/backend
# Yedek: EmailVerify.io Single Validation (https://app.emailverify.io/api-setup)
EMAILVERIFY_API_KEY=
EMAILVERIFY_TIMEOUT_MS=15000
EMAILVERIFY_MONTHLY_LIMIT=3000
# Panelde önceden harcanmış haklar (yerel ofset)
EMAILVERIFY_USAGE_OFFSET=0
# Reacher/EmailVerify yoksa yalnızca MX ile soft kabul (dev)
EMAIL_VERIFY_MX_ONLY_FALLBACK=true
EMAIL_VERIFY_DELAY_MS=1500
# EmailVerify ~1 req/s — ardışık istekler arası minimum (ms)
EMAILVERIFY_MIN_GAP_MS=1500
